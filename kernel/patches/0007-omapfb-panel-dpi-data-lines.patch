omapfb panel-dpi: read the optional DT 'data-lines' property.
Without it the DPI panel is taken as 16-bit and omapfb allocates framebuffer
memory for one 16bpp frame only, which breaks the 32bpp XRGB8888 mode all native
apps use. Status doc: 'still needed' on 7.3.4.

--- a/drivers/video/fbdev/omap2/omapfb/displays/panel-dpi.c	2026-11-15 11:37:04.996910767 -0500
+++ b/drivers/video/fbdev/omap2/omapfb/displays/panel-dpi.c	2026-11-15 11:37:05.000911075 -0500
@@ -144,6 +144,7 @@
 	struct display_timing timing;
 	struct videomode vm;
 	struct gpio_desc *gpio;
+	u32 data_lines;
 
 	gpio = devm_gpiod_get_optional(&pdev->dev, "enable", GPIOD_OUT_LOW);
 	if (IS_ERR(gpio))
@@ -160,6 +161,11 @@
 	videomode_from_timing(&timing, &vm);
 	videomode_to_omap_video_timings(&vm, &ddata->videomode);
 
+	/* Without data-lines the DPI panel is taken as 16-bit, and omapfb then
+	 * allocates fb memory for one 16bpp frame only. */
+	if (!of_property_read_u32(node, "data-lines", &data_lines))
+		ddata->data_lines = data_lines;
+
 	in = omapdss_of_find_source_for_first_ep(node);
 	if (IS_ERR(in)) {
 		dev_err(&pdev->dev, "failed to find video source\n");
