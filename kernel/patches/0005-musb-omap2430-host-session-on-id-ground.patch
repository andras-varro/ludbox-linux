musb omap2430: start a host session on every ID-ground mailbox event (host-only kernel).
Upstream's default: arm of omap_musb_set_mailbox() starts VBUS only if a
gadget_driver is bound, which never happens here, so a plug is seen and dropped.
Neither omap2430_ops nor phy-twl4030-usb has a set_vbus op, so otg_set_vbus(1)
is a no-op; SESSION is written only by musb_start() at probe (boot-plugged
devices worked, hot-plugged ones did not). Call musb_set_host() instead, retried
8 x 500 ms because PHY/ID needs time to settle (measured: one 1 s try failed).
Series order: apply after 0004 (this patch is the delta on top of it).

--- a/drivers/usb/musb/omap2430.c	2026-11-15 11:37:04.952907389 -0500
+++ b/drivers/usb/musb/omap2430.c	2026-11-15 11:37:04.952907389 -0500
@@ -91,7 +91,7 @@
 static void omap_musb_set_mailbox(struct omap2430_glue *glue)
 {
 	struct musb *musb = glue_to_musb(glue);
-	int error;
+	int error, retry;
 
 	pm_runtime_get_sync(musb->controller);
 
@@ -121,11 +121,24 @@
 		default:
 			musb->xceiv->otg->state = OTG_STATE_A_IDLE;
 			musb->xceiv->last_event = USB_EVENT_ID;
-			if (musb->gadget_driver) {
-				omap_control_usb_set_mode(glue->control_otghs,
-							  USB_MODE_HOST);
-				otg_set_vbus(musb->xceiv->otg, 1);
+			/* Upstream starts the session only when a gadget driver
+			 * is bound, which never happens on a host-only kernel:
+			 * the plug is seen and dropped, and VBUS stays off.
+			 */
+			omap_control_usb_set_mode(glue->control_otghs,
+						  USB_MODE_HOST);
+			/* No set_vbus op on this board: write SESSION via musb_set_host(). */
+			/* PHY and ID need time to settle after a plug: retry (measured: one 1 s try fails). */
+			for (retry = 0; retry < 8; retry++) {
+				error = musb_set_host(musb);
+				if (!error)
+					break;
+				msleep(500);
 			}
+			if (error)
+				break;
+			musb->xceiv->otg->state = OTG_STATE_A_WAIT_VRISE;
+			otg_set_vbus(musb->xceiv->otg, 1);
 			break;
 		}
 		break;
