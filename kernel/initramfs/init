#!/bin/busybox sh
/bin/busybox --install -s /bin
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mount -t debugfs none /sys/kernel/debug 2>/dev/null
exec >/dev/console 2>&1 </dev/console

# --- breadcrumb 1: green LED on (pwm-leds, names come from the DT node names) ---
led() { # led <green|red> <value>
  for f in /sys/class/leds/*$1*/brightness; do [ -e "$f" ] && echo "$2" > "$f"; done
}
led green 100

say() { echo "$@"; [ -c /dev/ttyO1 ] && echo "$@" >/dev/ttyO1; }
say "ARCA 7.3.4 INITRAMFS ALIVE (k73g)"

# --- watchdog: busybox watchdog applet feeds /dev/watchdog every 10 s ---
WD=0
if [ -c /dev/watchdog ]; then
  watchdog -t 10 -T 60 /dev/watchdog && WD=1
fi

# --- p1 (vfat) at /mnt/p1 ---
mkdir -p /mnt/p1
i=0
while [ ! -b /dev/mmcblk0p1 ] && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); done
P1=0
LOG=/mnt/p1/k73-boot.log
if [ -b /dev/mmcblk0p1 ] && mount -t vfat -o rw /dev/mmcblk0p1 /mnt/p1; then
  P1=1
else
  say "p1 mount FAILED (node waited ${i}s)"
fi
[ $P1 = 1 ] && : > $LOG
lg() { if [ $P1 = 1 ]; then echo "$@" >> $LOG; fi; }
sec() { lg ""; lg "=== $*"; }
run() { sec "$*"; if [ $P1 = 1 ]; then "$@" >> $LOG 2>&1; fi; }

if [ $P1 = 1 ]; then
  lg "k73-boot.log (initramfs k73g)"
  lg "p1 mounted rw after ${i}s; busybox watchdog started: $WD"
  run date
  run uname -a
  run cat /proc/cmdline
  run dmesg
  run cat /proc/fb
  run sh -c 'ls -l /dev/fb* /dev/input /dev/mmcblk* /dev/ttyO*'
  for d in leds backlight net mmc_host watchdog input; do
    run sh -c "ls /sys/class/$d"
  done
  run cat /proc/iomem
  run cat /proc/interrupts
  sec "usb devices (sysfs)"
  for d in /sys/bus/usb/devices/*; do
    [ -e "$d" ] || continue
    lg "$d: $(cat $d/manufacturer 2>/dev/null) / $(cat $d/product 2>/dev/null) / $(cat $d/idVendor 2>/dev/null):$(cat $d/idProduct 2>/dev/null)"
  done
  sec "dmesg usb/musb"
  dmesg | grep -i -E 'usb|musb' >> $LOG 2>&1
  run sh -c 'ls -R /sys/kernel/debug 2>&1 | head -n 150'
  sync
fi
# --- breadcrumb 2: log written (or p1 unavailable: red on anyway) ---
led red 100
say "k73-boot.log written (p1=$P1)"

# --- switch to the real root unless the cmdline has arca_root=0 (the card's U-Boot passes no arca_root) ---
case " $(cat /proc/cmdline) " in
*" arca_root=0 "*) ;;
*)
  echo 100 > /sys/class/leds/backlight/brightness 2>/dev/null
  lg ""; lg "=== switching to real root: trying real root /dev/mmcblk0p3"
  k=0
  while [ ! -b /dev/mmcblk0p3 ] && [ $k -lt 20 ]; do sleep 1; k=$((k+1)); done
  mkdir -p /newroot
  if [ ! -b /dev/mmcblk0p3 ]; then
    lg "FALLBACK: /dev/mmcblk0p3 absent after ${k}s"
  elif ! mount -t ext4 -o rw /dev/mmcblk0p3 /newroot >> $LOG 2>&1; then
    lg "FALLBACK: mount ext4 rw p3 failed"; dmesg | tail -n 15 >> $LOG 2>&1
  elif [ ! -x /newroot/sbin/init ]; then
    lg "FALLBACK: /newroot/sbin/init missing or not executable"; ls -l /newroot/sbin >> $LOG 2>&1
    umount /newroot
  else
    lg "p3 mounted; /sbin/init present; switching root (dmesg saved above)"
    dmesg > /mnt/p1/k73-dmesg-prechange.log 2>&1
    sync
    mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/mnt
    umount /mnt/p1 2>/dev/null
    mount --move /sys /newroot/sys && mount --move /proc /newroot/proc && mount --move /dev /newroot/dev
    exec switch_root /newroot /sbin/init
    # only reached if exec failed
  fi
  say "switch to real root FAILED, staying in initramfs shell"
  ;;
esac

# --- background loop: every 20 s append, feed watchdog every 10 s, 5-min mark ---
(
  n=0
  while [ $n -lt 720 ]; do
    :
    sleep 10
    :
    sleep 10
    n=$((n+1))
    if [ $P1 = 1 ]; then
      {
        echo ""
        echo "--- t+$((n*20))s uptime: $(cat /proc/uptime)"
        dmesg | tail -n 30
        if [ $((n % 15)) = 0 ]; then
          echo "--- 5-minute mark n=$n"
          cat /proc/interrupts
          ls /sys/class/leds /sys/class/net
        fi
      } >> $LOG 2>&1
      sync
    fi
  done
) &

say "=== shells follow (ttyO1 and tty0)"
for t in ttyO1 tty0; do
  [ -c /dev/$t ] || continue
  ( while :; do setsid sh -c "exec sh </dev/$t >/dev/$t 2>&1"; sleep 1; done ) &
done
while :; do sleep 3600; done
