#!/bin/sh
# arca-backup - selectable export/import of a unit's settings and scores, for the Control Panel.
#
# Usage:
#   arca-backup items                        list the backup items this unit declares
#   arca-backup export <dir> <id>...         write <dir>/ludbox-backup-<host>-<stamp>.tar.gz
#   arca-backup archives <dir>               list the backup archives in <dir>, newest first
#   arca-backup contents <archive>           what an archive holds, as THIS unit understands it
#   arca-backup import <archive> <id>...     restore the selected items from an archive
#
# Stdout is a contract that callers parse, one line per fact:
#   item <id> unit=<yes|no> secret=<yes|no> reboot=<yes|no> [default=no] <name...>   (default=no only for such items)
#   note <id> <text>              (items only, right after that item's line, only for an item with note=<text>: shown to the user when they mark it)
#   exported <full path>
#   archive <filename>
#   info host=<h> version=<v> date=<d>
#   unknown <id>                  (contents: an id the archive has and this unit does not declare)
#   imported <id>
#   done reboot=<yes|no>
#   error <text>                  (and a nonzero exit; nothing is written after it)
#
# What "state" is: the item files /opt/arca/backup.d/<id>.item, one per item, installed by the
# component that owns the files (format: DEVELOPING.md#plug-in-file-formats). This
# script knows no path of its own. ARCA_ROOT (default empty, meaning /) moves the whole tree
# for the host test and nothing else.
#
# Import writes ONLY paths the importing unit's own item files declare for the selected ids, and
# an archive is refused whole if any member is absolute, has a ".." component, is a hard link, or
# is a symlink that a later member is written through. Existing files are overwritten, never deleted.
# A glob in paths= matches whole path components only ("home/root/data/*.hig" does not reach
# "home/root/data/x/y.hig" by itself; a declared directory carries everything under it).
#
# BusyBox tar flags only: c x t v f C T. This BusyBox tar has no -z (measured on .115, 2026-10-18), so
# gzip is a separate stage of a pipe and nothing large is ever staged: /tmp is a 117 MB tmpfs (RAM) on
# the unit, and a 2 GB item exported or imported through a temp copy failed. Export streams tar into
# gzip, writing "$out.part" and renaming it on success; every import reader re-reads the .gz.
# The info member is tmp/ludbox-backup.info, written under the root's tmp for the length of the
# export so every member shares one -C and nothing lands in /. Import never extracts it.

ROOT="${ARCA_ROOT:-}"
ITEMDIR="${ARCA_BACKUP_ITEMS:-$ROOT/opt/arca/backup.d}"   # override: provision.sh runs the repo's items
INFO=tmp/ludbox-backup.info
TMP=""
PART=""
LINESTAGED=""

die() {
  echo "error $*"
  exit 1
}

cleanup() {
  [ -n "$TMP" ] && rm -rf "$TMP"
  [ -n "$PART" ] && rm -f "$PART"
  rm -f "$ROOT/$INFO"
  [ -n "$LINESTAGED" ] && rm -f "$ROOT/tmp/ludbox-line-"*
}
trap cleanup EXIT
trap 'exit 1' INT TERM

mktmp() {
  TMP="${TMPDIR:-/tmp}/arca-backup.$$"
  rm -rf "$TMP"
  mkdir -p "$TMP" || die "cannot create $TMP"
}

# getkey <file> <key>: first value of key=value
getkey() {
  sed -n "s/^$2=//p" "$1" | head -n 1 | tr -d '\r'
}

valid_id() {
  case "$1" in
    "" | *[!a-z0-9_-]*) return 1 ;;
  esac
  return 0
}

item_file() {
  valid_id "$1" || return 1
  [ -f "$ITEMDIR/$1.item" ] || return 1
  echo "$ITEMDIR/$1.item"
}

yesno() {
  [ "$1" = yes ] && echo yes || echo no
}

# item_line <id>: the "item" contract line
item_line() {
  f="$ITEMDIR/$1.item"
  n=$(getkey "$f" name)
  # default=no (an item that starts unmarked in the export view) is printed only when set, so a
  # caller that predates the key reads every other line unchanged.
  d=
  [ "$(getkey "$f" default)" = no ] && d="default=no "
  echo "item $1 unit=$(yesno "$(getkey "$f" unit)") secret=$(yesno "$(getkey "$f" secret)") reboot=$(yesno "$(getkey "$f" reboot)") ${d}${n:-$1}"
}

cmd_items() {
  for f in "$ITEMDIR"/*.item; do
    [ -f "$f" ] || continue
    id=${f##*/}
    id=${id%.item}
    valid_id "$id" || continue
    item_line "$id"
    nt=$(getkey "$ITEMDIR/$id.item" note)
    if [ -n "$nt" ]; then echo "note $id $nt"; fi
  done
}

host_name() {
  if [ -n "$ROOT" ]; then
    cat "$ROOT/etc/hostname" 2> /dev/null
  else
    hostname 2> /dev/null
  fi
}

os_version() {
  sed -n 's/^VERSION_ID=//p' "$ROOT/etc/os-release" 2> /dev/null | head -n 1 | tr -d "\"'"
}

# prune_covered: stdin names to stdout, minus any name lying under another name in the list. tar
# extracts or archives a directory with everything below it, and a name listed again below it
# is archived twice (export) or reported "Not found in archive" (import, GNU tar). This is what
# lets two items overlap, e.g. a games directory and the option files inside it.
prune_covered() {
  awk '
    { line[NR] = $0; k = $0; sub(/^\.\//, "", k); sub(/\/$/, "", k); key[NR] = k; dir[k] = 1 }
    END {
      for (i = 1; i <= NR; i++) {
        n = split(key[i], c, "/"); pre = ""; keep = 1
        for (j = 1; j < n; j++) { pre = pre (j > 1 ? "/" : "") c[j]; if (pre in dir) { keep = 0; break } }
        if (keep) print line[i]
      }
    }'
}

# line_spec <id>: sets LPATH and LPFX from the item's line=<path>:<prefix>; fails when it has none.
# Such an item backs up one line of a shared file (root's line of etc/shadow), not the whole file.
line_spec() {
  ls_v=$(getkey "$ITEMDIR/$1.item" line)
  [ -n "$ls_v" ] || return 1
  LPATH=${ls_v%%:*}
  LPFX=${ls_v#*:}
  case "$LPATH" in "" | /* | .. | ../* | */.. | */../*) return 1 ;; esac
  [ -n "$LPFX" ]
}

# line_stage <id>: writes tmp/ludbox-line-<id> under the root with the first line of LPATH that
# starts with LPFX (nothing if there is none); the member the archive carries for a line= item.
line_stage() {
  ( umask 077; awk -v p="$LPFX" 'index($0, p) == 1 { print; exit }' "$ROOT/$LPATH" 2> /dev/null > "$ROOT/tmp/ludbox-line-$1" )
  [ -s "$ROOT/tmp/ludbox-line-$1" ] || rm -f "$ROOT/tmp/ludbox-line-$1"
}

# line_restore <member-file>: replaces (or adds) that one line in LPATH, atomically: a copy
# made with cp -p keeps mode and owner, is rewritten in the same directory and renamed over.
line_restore() {
  lr_l=$(head -n 1 "$1")
  case "$lr_l" in "$LPFX"*) ;; *) return 0 ;; esac
  lr_t="$ROOT/$LPATH"
  lr_n="$lr_t.new"
  if [ -f "$lr_t" ]; then cp -p "$lr_t" "$lr_n" || return 1; else : > "$lr_n" && chmod 600 "$lr_n" || return 1; fi
  if awk -v p="$LPFX" -v f="$1" 'BEGIN { getline l < f; close(f) }
      index($0, p) == 1 { if (!d) print l; d = 1; next } { print }
      END { if (!d) print l }' "$lr_t" 2> /dev/null > "$lr_n"; then
    mv "$lr_n" "$lr_t" || { rm -f "$lr_n"; return 1; }
  else
    rm -f "$lr_n"
    return 1
  fi
}

cmd_export() {
  [ $# -ge 2 ] || die "usage: export <dir> <id>..."
  dir=$1
  shift
  for id in "$@"; do
    item_file "$id" > /dev/null || die "unknown item $id"
  done
  mktmp
  : > "$TMP/list"
  for id in "$@"; do
    paths=$(getkey "$ITEMDIR/$id.item" paths)
    # shellcheck disable=SC2086
    (cd "${ROOT:-/}" && for p in $paths; do
      for g in $p; do
        { [ -e "$g" ] || [ -L "$g" ]; } && echo "$g"
      done
    done) >> "$TMP/list"
  done
  mkdir -p "$ROOT/tmp" || die "cannot create $ROOT/tmp"
  for id in "$@"; do
    line_spec "$id" && line_stage "$id" && LINESTAGED=1
    [ -f "$ROOT/tmp/ludbox-line-$id" ] && echo "tmp/ludbox-line-$id" >> "$TMP/list"
  done
  host=$(host_name)
  host=${host:-unit}
  stamp=$(date +%Y%m%d-%H%M)
  {
    echo "host=$host"
    echo "version=$(os_version)"
    echo "date=$stamp"
    echo "ids=$*"
  } > "$ROOT/$INFO" || die "cannot write the info member"
  mkdir -p "$dir" || die "cannot create $dir"
  out="$dir/ludbox-backup-$host-$stamp.tar.gz"
  # The info member goes FIRST: read_info stops reading after it, so opening a multi-GB archive costs
  # a few KB of gzip, not the whole stream. It is added here, not to list, so sort cannot move it.
  { echo "$INFO"; sort -u "$TMP/list" | prune_covered | awk -v i="$INFO" '$0 != i'; } > "$TMP/list.u"
  # Stream tar into gzip. POSIX sh has no pipefail: tar's status goes to a file from inside the left
  # side of the pipe, gzip's is the pipeline's own. A missing or non-zero status file is a failure.
  PART="$out.part"
  rm -f "$TMP/rc"
  if { { tar -cf - -C "${ROOT:-/}" -T "$TMP/list.u"; echo "$?" > "$TMP/rc"; } | gzip -c > "$PART"; } \
    && [ "$(cat "$TMP/rc" 2> /dev/null)" = 0 ]; then
    mv "$PART" "$out" || die "tar failed"
  else
    rm -f "$PART" "$out"
    die "tar failed"
  fi
  PART=""
  echo "exported $out"
}

cmd_archives() {
  [ $# -eq 1 ] || die "usage: archives <dir>"
  [ -d "$1" ] || return 0
  # Newest first by modification time.
  # shellcheck disable=SC2012
  ls -t "$1" 2> /dev/null | while read -r n; do
    case "$n" in
      ludbox-backup-*.tar.gz) echo "archive $n" ;;
    esac
  done
}

# read_info <archive>: sets TMP, INFO_HOST/VERSION/DATE/IDS
read_info() {
  [ -f "$1" ] || die "no such archive $1"
  mktmp
  # Fast path: export writes the info member first, and it is 4 short lines (a 512-byte header and
  # one data block, ~1 KB even with a hundred ids), so the first 256 KiB of the decompressed stream
  # holds it with wide margin. head ends the pipe; gzip stops on SIGPIPE; tar of the truncated tail
  # errors after the member is out, which is fine. Accepted only with its ids= line, so a member cut by
  # the bound is never trusted.
  gzip -dc "$1" 2> /dev/null | head -c 262144 | tar -xf - -C "$TMP" "$INFO" 2> /dev/null
  grep -q '^ids=' "$TMP/$INFO" 2> /dev/null || {
    # Archives made before the info member moved to the front have it last: read the whole stream.
    rm -f "$TMP/$INFO"
    gzip -dc "$1" 2> /dev/null | tar -xf - -C "$TMP" "$INFO" 2> /dev/null
  }
  # The status is the last stage's only; a bad gzip stream leaves no info member, which is caught here.
  [ -f "$TMP/$INFO" ] || die "not a backup archive $1"
  INFO_HOST=$(getkey "$TMP/$INFO" host)
  INFO_VERSION=$(getkey "$TMP/$INFO" version)
  INFO_DATE=$(getkey "$TMP/$INFO" date)
  INFO_IDS=$(getkey "$TMP/$INFO" ids)
}

cmd_contents() {
  [ $# -eq 1 ] || die "usage: contents <archive>"
  read_info "$1"
  echo "info host=$INFO_HOST version=$INFO_VERSION date=$INFO_DATE"
  for id in $INFO_IDS; do
    if item_file "$id" > /dev/null; then
      item_line "$id"
    else
      echo "unknown $id"
    fi
  done
}

# slashes <string>: number of "/" in it
slashes() {
  u=$1
  c=0
  while [ "$u" != "${u#*/}" ]; do
    u=${u#*/}
    c=$((c + 1))
  done
  echo "$c"
}

# member_matches <member> <pattern>: the member is the pattern or lies under it
member_matches() {
  mm=$1
  pp=$2
  nn=$(slashes "$pp")
  cc=$(slashes "$mm")
  while [ "$cc" -gt "$nn" ]; do
    mm=${mm%/*}
    cc=$((cc - 1))
  done
  # shellcheck disable=SC2254
  case "$mm" in
    $pp) return 0 ;;
  esac
  return 1
}

# check_safe <archive>: refuse the whole archive on a member that could land outside the item paths
check_safe() {
  gzip -dc "$1" 2> /dev/null | tar -tf - > "$TMP/members" 2> "$TMP/tarerr" || die "cannot read archive $1"
  # BusyBox and GNU tar both strip a leading "/" or "../" and say so on stderr: that is an unsafe member.
  bad=$(sed -n "s/^tar: [Rr]emoving leading '\(.*\)' from \(member\|hard link\)[ a-z]*$/\1/p" "$TMP/tarerr" | head -n 1)
  [ -z "$bad" ] || die "unsafe member $bad"
  while IFS= read -r m; do
    case "$m" in
      /* | .. | ../* | */.. | */../*) die "unsafe member $m" ;;
    esac
  done < "$TMP/members"
  # Links: a hard link (GNU: type h or "link to"; BusyBox: a "-" line with "name -> target"), or a
  # symlink that another member is written through.
  gzip -dc "$1" 2> /dev/null | tar -tvf - 2> /dev/null | awk '
    { t = substr($0, 1, 1); n = $6 }
    t == "h" || (t != "l" && $7 == "->") || /link to / { print "H " n; next }
    t == "l" { sub(/\/$/, "", n); links[n] = 1 }
    { names[NR] = $6 }
    END {
      for (i = 1; i <= NR; i++) {
        s = names[i]
        while (sub(/\/[^\/]*$/, "", s)) if (s in links) { print "L " names[i]; break }
      }
    }' > "$TMP/badlinks"
  if [ -s "$TMP/badlinks" ]; then
    read -r _ bad < "$TMP/badlinks"
    die "unsafe member $bad"
  fi
}

cmd_import() {
  [ $# -ge 2 ] || die "usage: import <archive> <id>..."
  arc=$1
  shift
  read_info "$arc"
  check_safe "$arc"
  for id in "$@"; do
    item_file "$id" > /dev/null || die "unknown item $id"
    case " $INFO_IDS " in
      *" $id "*) ;;
      *) die "item not in archive $id" ;;
    esac
  done
  # One extract pass for every selected item: each pass decompresses the whole
  # archive, which is minutes on this CPU once retro games are in it.
  reboot=no
  : > "$TMP/sel"
  for id in "$@"; do
    paths=$(getkey "$ITEMDIR/$id.item" paths)
    while IFS= read -r m; do
      s=${m#./}
      s=${s%/}
      [ -n "$s" ] || continue
      [ "$s" = "$INFO" ] && continue
      for p in $paths; do
        if member_matches "$s" "$p"; then
          echo "$m" >> "$TMP/sel"
          break
        fi
      done
    done < "$TMP/members"
    [ "$(getkey "$ITEMDIR/$id.item" reboot)" = yes ] && reboot=yes
  done
  if [ -s "$TMP/sel" ]; then
    sort -u "$TMP/sel" | prune_covered > "$TMP/sel.p"
    gzip -dc "$arc" 2> /dev/null | tar -xf - -C "${ROOT:-/}" -T "$TMP/sel.p" || die "tar failed"
  fi
  # line= items: the member is one staged line, merged into the target file, never extracted over it.
  # An archive without the member (or with a line that lacks the prefix) leaves the file untouched.
  for id in "$@"; do
    line_spec "$id" || continue
    grep -qx "tmp/ludbox-line-$id" "$TMP/members" || continue
    gzip -dc "$arc" 2> /dev/null | tar -xf - -C "$TMP" "tmp/ludbox-line-$id" || die "tar failed"
    line_restore "$TMP/tmp/ludbox-line-$id" || die "cannot write $LPATH"
    [ "$(getkey "$ITEMDIR/$id.item" reboot)" = yes ] && reboot=yes
  done
  for id in "$@"; do echo "imported $id"; done
  echo "done reboot=$reboot"
}

cmd=$1
[ $# -gt 0 ] && shift
case "$cmd" in
  items) cmd_items ;;
  export) cmd_export "$@" ;;
  archives) cmd_archives "$@" ;;
  contents) cmd_contents "$@" ;;
  import) cmd_import "$@" ;;
  *) die "usage: arca-backup items | export <dir> <id>... | archives <dir> | contents <archive> | import <archive> <id>..." ;;
esac
