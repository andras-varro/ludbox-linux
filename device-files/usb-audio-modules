#!/bin/sh
# Load the USB audio class module.
#
# The ALSA core, its OSS emulation and the on-board TWL4030 codec are compiled into the
# kernel, so a USB DAC needs only the class driver (CONFIG_SND_USB_AUDIO=m); modprobe
# resolves snd-hwdep, snd-rawmidi and snd-usbmidi-lib from modules.dep. Loading it registers
# a USB interface driver, which re-probes devices already on the bus, so this does not have
# to run before the dongle is plugged in.
#
# Result on the first card that appears: ALSA card 1, and OSS minor 14,19 -> /dev/dsp1.
# SND_DYNAMIC_MINORS is unset in the kernel config, so that number is deterministic.
#
# start exits 0 either way: a unit with no dongle must still boot.

case "$1" in
  start)
    echo "Loading USB audio modules..."
    modprobe snd-usb-audio 2>/tmp/usb-audio-insmod.err && echo "  snd-usb-audio: loaded" || echo "  snd-usb-audio: FAILED -- $(cat /tmp/usb-audio-insmod.err)"
    echo "USB audio modules done"
    ;;
  stop)
    echo "Unloading USB audio modules..."
    rmmod snd_usb_audio 2>/dev/null
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
