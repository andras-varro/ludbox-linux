#!/bin/sh
# Load Xbox controller kernel modules
# Must run before S90usb-host
#
# Mainline kernel: the in-tree xpad is built as a module (CONFIG_JOYSTICK_XPAD=m); modprobe
# resolves ff-memless from modules.dep.

case "$1" in
  start)
    echo "Loading Xbox controller modules..."
    modprobe ff-memless 2>/dev/null
    modprobe joydev 2>/dev/null
    if modprobe xpad 2>/dev/null; then
      echo "Xbox controller modules loaded"
    else
      echo "  xpad module not available on this kernel: Xbox pad over USB unsupported"
    fi
    ;;
  stop)
    echo "Unloading Xbox controller modules..."
    rmmod xpad 2>/dev/null
    rmmod joydev 2>/dev/null
    rmmod ff_memless 2>/dev/null
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
