#!/bin/sh
# Load the USB mass-storage module: usb-storage.
#
# SCSI, the SCSI disk driver, FAT/VFAT/MSDOS and the 437 / ISO-8859-1 code pages are compiled
# into the kernel; USB_STORAGE is a module (CONFIG_USB_STORAGE=m), so a stick needs it.
# modprobe resolves its dependencies from modules.dep.
#
# Loading registers a USB interface driver, which re-probes devices already on the bus, so
# this does not have to run before the stick is plugged in. Mounting is not done here.
#
# start exits 0 whatever happens: a unit without the module must still boot.

case "$1" in
  start)
    echo "Loading USB storage modules..."
    modprobe usb-storage 2>/dev/null || echo "  usb-storage: built in or absent"
    echo "USB storage modules done"
    ;;
  stop)
    echo "Unloading USB storage modules..."
    rmmod usb_storage 2>/dev/null
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
